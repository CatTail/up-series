    {
      "personId": "john",
      "filmId": "f35",
      "dims": {
        "education": {
          "status": "confirmed",
          "text": {
            "zh": "曾就读 Westminster School，后在牛津大学 Christ Church 学院读法律。",
            "en": "Went to Westminster School and read Law at Christ Church, Oxford."
          },
          "sourceIds": [
            "film-f35"
          ]
        },
        "work": {
          "status": "confirmed",
          "text": {
            "zh": "出庭律师，在高等法院衡平法庭执业，专攻公司法。",
            "en": "A barrister in the Chancery division of the High Court, specialising in company law."
          },
          "sourceIds": [
            "film-f35"
          ]
        },
        "family": {
          "status": "confirmed",
          "text": {
            "zh": "已与 Claire 结婚，她是一位前驻保加利亚大使的女儿。",
            "en": "Married to Claire, daughter of a former ambassador to Bulgaria."
          },
          "sourceIds": [
            "film-f35",
            "p-john-wiki"
          ]
        },
        "residence": {
          "status": "confirmed",
          "text": {
            "zh": "在伦敦有一处住宅，在乡间另有一处。",
            "en": "Has a house in London and another in the country."
          },
          "sourceIds": [
            "film-f35",
            "film-f49"
          ]
        },
        "events": {
          "status": "confirmed",
          "text": {
            "zh": "拒绝参与 28 岁那集后回归，他说这次只是为了让观众关注保加利亚的困境。",
            "en": "Returned after refusing to take part at 28, saying he did so only to draw attention to Bulgaria's problems."
          },
          "sourceIds": [
            "film-f35",
            "thenation-pedersen-2020"
          ]
        },
        "outlook": {
          "status": "confirmed",
          "text": {
            "zh": "被问及他和 Claire 能否住在保加利亚的家族土地上，他说：七年后再问我吧。",
            "en": "Asked if he and Claire could live on the family land in Bulgaria, he said: ask me in seven years."
          },
          "sourceIds": [
            "film-f35"
          ],
          "questionIds": [
            "f35-038"
          ]
        }
      }
    },
