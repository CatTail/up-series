            "en": "He has completely changed his mind about becoming an astronaut, calling it a seven-year-old's imagination."
          },
          "sourceIds": [
            "film-f14"
          ]
        },
        "family": {
          "status": "not_found"
        },
        "residence": {
          "status": "confirmed",
