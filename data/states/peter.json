    {
      "personId": "peter",
      "filmId": "f21",
      "dims": {
        "education": {
          "status": "confirmed",
          "text": {
            "zh": "在伦敦大学读历史，正读最后一年。",
            "en": "In his final year at London University, reading history."
          },
          "sourceIds": [
            "film-f21"
          ]
        },
        "work": {
          "status": "not_found"
        },
        "family": {
          "status": "not_found"
        },
        "residence": {
          "status": "confirmed",
          "text": {
            "zh": "在伦敦北部与另外三名学生合租一套公寓。",
            "en": "Shares a flat in North London with three other students."
          },
          "sourceIds": [
            "film-f21"
          ]
        },
        "events": {
          "status": "confirmed",
          "text": {
            "zh": "已离开利物浦到伦敦上大学；他记得那天下着大雨，父母到车站送行。",
            "en": "Has left Liverpool to study in London; he remembers his parents seeing him off at the station in pouring rain."
          },
          "sourceIds": [
            "film-f21"
          ]
        },
        "outlook": {
          "status": "confirmed",
          "text": {
            "zh": "毕业后做什么还没着落，但这并不让他沮丧，甚至可能让他有点兴奋。",
            "en": "Not knowing what job he will have after graduating doesn't depress him; perhaps it even excites him."
          },
          "sourceIds": [
            "film-f21"
          ],
          "questionIds": [
            "f21-097",
            "f21-098"
          ]
        }
      }
    },
    {
      "personId": "peter",
      "filmId": "f28",
      "dims": {
        "education": {
          "status": "confirmed",
          "text": {
            "zh": "伦敦大学毕业后接受教师培训，并在师范学院认识了妻子。",
            "en": "Graduated from London University and trained as a teacher; he met his wife at teacher training college."
          },
          "sourceIds": [
            "film-f28",
            "film-f56"
          ]
        },
        "work": {
          "status": "confirmed",
          "text": {
            "zh": "在一所综合中学教书；他说教师不受重视，工资低得可怜。",
            "en": "Teaches in a comprehensive school; he says teachers are undervalued and their pay is abysmal."
          },
          "sourceIds": [
            "film-f28"
          ],
          "questionIds": [
            "f28-049"
          ]
        },
        "family": {
          "status": "confirmed",
          "text": {
            "zh": "与 Rachel 结婚四年，暂时没有生孩子的打算。",
            "en": "Married to Rachel for four years; they have no plans for children yet."
          },
          "sourceIds": [
            "film-f28"
          ],
          "questionIds": [
            "f28-039"
          ]
        },
        "residence": {
          "status": "confirmed",
          "text": {
            "zh": "他和 Rachel 刚在莱斯特市中心买下第一套房子，一栋联排住宅。",
            "en": "He and Rachel have just bought their first home, a terraced house in the centre of Leicester."
          },
          "sourceIds": [
            "film-f28"
          ]
        },
        "events": {
          "status": "confirmed",
          "text": {
            "zh": "上一部之后他与 Rachel 结婚并买了第一套房；直到不久前他还在一支本地乐队演出。",
            "en": "Since the last film he has married Rachel and bought a first home; until recently he played in a local band."
          },
          "sourceIds": [
            "film-f28"
          ],
          "questionIds": [
            "f28-048"
          ]
        },
        "outlook": {
          "status": "confirmed",
          "text": {
            "zh": "他觉得自己远没有得到和别人一样公平的机会，教书也从没让他兴奋过。",
            "en": "He feels he has had nothing like as fair a chance as others, and gets no excitement from teaching."
          },
          "sourceIds": [
            "film-f28"
          ],
          "questionIds": [
            "f28-044",
            "f28-049"
          ]
        }
      }
    },
