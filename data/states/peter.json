    {
      "personId": "peter",
      "filmId": "f56",
      "dims": {
        "education": {
          "status": "confirmed",
          "text": {
            "zh": "拥有伦敦大学历史学位；离开教职后又学了法律。",
            "en": "Has a history degree from London University; after leaving teaching he studied law."
          },
          "sourceIds": [
            "film-f56",
            "cbs-up-children-2013"
          ]
        },
        "work": {
          "status": "confirmed",
          "text": {
            "zh": "在公务员系统的就业与养老金部工作，并在乐队 The Good Intentions 演出。",
            "en": "Works in the Civil Service, at the Department for Work and Pensions, and plays in his band, The Good Intentions."
          },
          "sourceIds": [
            "film-f56"
          ],
          "questionIds": [
            "f56-040",
            "f56-035"
          ]
        },
        "family": {
          "status": "confirmed",
          "text": {
            "zh": "第二次婚姻，妻子是 Gabby；儿子 19 岁在读大学，女儿 16 岁即将考 GCSE。",
            "en": "In his second marriage, to Gabby; their son, 19, is at university and their daughter, 16, faces her GCSEs."
          },
          "sourceIds": [
            "film-f56",
            "cbs-up-children-2013",
            "p-peter-ti-bio"
          ],
          "questionIds": [
            "f56-038",
            "f56-042"
          ]
        },
        "residence": {
          "status": "not_found"
        },
        "events": {
          "status": "confirmed",
          "text": {
            "zh": "为宣传乐队重返系列；28 岁之后他离开教职、学了法律、进入公务员系统并再婚。",
            "en": "Returned to the series to promote his band; since 28 he had left teaching, studied law, joined the Civil Service and remarried."
          },
          "sourceIds": [
            "film-f56"
          ],
          "questionIds": [
            "f56-033",
            "f56-034"
          ]
        },
        "outlook": {
          "status": "confirmed",
          "text": {
            "zh": "他说自己活得自在多了，并称再婚和两个孩子的出生是人生中极其重要的时刻。",
            "en": "He feels much happier in his own skin, and calls his second marriage and two children hugely significant moments."
          },
          "sourceIds": [
            "film-f56"
          ],
          "questionIds": [
            "f56-034",
            "f56-042"
          ]
        }
      }
    },
    {
      "personId": "peter",
      "filmId": "f63",
      "dims": {
        "education": {
          "status": "confirmed",
          "text": {
            "zh": "拥有伦敦大学历史学位。",
            "en": "Has a history degree from London University."
          },
          "sourceIds": [
            "film-f63"
          ]
        },
        "work": {
          "status": "confirmed",
          "text": {
            "zh": "每周在公务员岗位上班两天，小说初稿写到一半，乐队也还在继续。",
            "en": "Works two days a week in his civil-service day job, is midway through drafting a novel, and still plays in the band."
          },
          "sourceIds": [
            "film-f63",
            "wiki-up-series"
          ],
          "questionIds": [
            "f63-059"
          ]
        },
        "family": {
          "status": "confirmed",
          "text": {
            "zh": "仍与妻子相守；儿子已搬进离家不远的自己的房子，女儿在金史密斯学院读硕士。",
            "en": "Still married; their son has moved into his own home nearby and their daughter is doing a master's at Goldsmiths."
          },
          "sourceIds": [
            "film-f63"
          ],
          "questionIds": [
            "f63-054"
          ]
        },
        "residence": {
          "status": "not_found"
        },
        "events": {
          "status": "confirmed",
          "text": {
            "zh": "三年前，八十多岁、患失智症的母亲去世；乐队成员 Frank 也在同一年离世。",
            "en": "Three years ago his mother, in her late 80s and with dementia, died; their bandmate Frank died the same year."
          },
          "sourceIds": [
            "film-f63",
            "wiki-up-series"
          ],
          "questionIds": [
            "f63-056"
          ]
        },
        "outlook": {
          "status": "confirmed",
          "text": {
            "zh": "他说唯一真正的遗憾会是临终时后悔没去尝试；他想创造能流传下去的东西。",
            "en": "His only serious regret would be reaching the end of his life wishing he had tried something; he wants to create something lasting."
          },
          "sourceIds": [
            "film-f63"
          ],
          "questionIds": [
            "f63-063"
          ]
        }
      }
    },
    {
      "personId": "peter",
      "filmId": "f70",
      "dims": {
        "education": {
          "status": "confirmed",
          "text": {
            "zh": "毕业于伦敦大学历史系。",
            "en": "Graduated in history from London University."
          },
          "sourceIds": [
            "p-peter-rpd-site"
          ]
        },
        "work": {
          "status": "confirmed",
          "text": {
            "zh": "他说自己比以往更忙，专注写歌、演出、录唱片和巡演，还写了小说、合写了音乐剧。",
            "en": "Says he is busier than ever, focused on songwriting, performing, recording and touring; he has written a novel and co-written a musical."
          },
          "sourceIds": [
            "film-f70",
            "wiki-up-series"
          ],
          "questionIds": [
            "f70-016"
          ]
        },
        "family": {
          "status": "confirmed",
          "text": {
            "zh": "已婚；他说当年是那时的伴侣、如今的妻子劝他为抑郁症去求助。",
            "en": "Married; he says it was his then-partner, now his wife, who once urged him to get help for depression."
          },
          "sourceIds": [
            "film-f70"
          ]
        },
        "residence": {
          "status": "confirmed",
          "text": {
            "zh": "住在利物浦南部。",
            "en": "Lives in south Liverpool."
          },
          "sourceIds": [
            "p-peter-rpd-site"
          ]
        },
        "events": {
          "status": "confirmed",
          "text": {
            "zh": "他的首部小说《Valediction Records》已经出版。",
            "en": "His debut novel, Valediction Records, has been published."
          },
          "sourceIds": [
            "p-peter-rpd-site",
            "p-peter-ti-home",
            "film-f70"
          ]
        },
        "outlook": {
          "status": "confirmed",
          "text": {
            "zh": "他不认为自己退休了：虽然不再教书，但他说自己比以往任何时候都忙。",
            "en": "He rejects being called retired: he no longer teaches, he says, but is busier than ever."
          },
          "sourceIds": [
            "film-f70"
          ],
          "questionIds": [
            "f70-016"
          ]
        }
      }
    }
