    {
      "personId": "lynn",
      "filmId": "f35",
      "dims": {
        "education": {
          "status": "not_found"
        },
        "work": {
          "status": "confirmed",
          "text": {
            "zh": "她说自己是两所学校的校董会成员。",
            "en": "She said she was on the governing body of two schools."
          },
          "sourceIds": [
            "film-f35",
            "film-f42"
          ]
        },
        "family": {
          "status": "confirmed",
          "text": {
            "zh": "与在邮局工作的 Russ 结婚，有两个女儿 Sarah 和 Emma。",
            "en": "Married to Russ, who works for the Post Office; they have two daughters, Sarah and Emma."
          },
          "sourceIds": [
            "film-f35"
          ]
        },
        "residence": {
          "status": "not_found"
        },
        "events": {
          "status": "confirmed",
          "text": {
            "zh": "母亲两年前去世；一年前她开始昏厥，检查发现脑部有异常血管。",
            "en": "Her mother had died two years earlier; blackouts a year ago led to the discovery of abnormal veins in her brain."
          },
          "sourceIds": [
            "film-f35",
            "film-f42"
          ],
          "questionIds": [
            "f35-024",
            "f35-025"
          ]
        },
        "outlook": {
          "status": "confirmed",
          "text": {
            "zh": "她说对脑部疾病的恐惧只持续了约一周，如今一点也不担心了。",
            "en": "She said the fear of her brain condition lasted about a week; now it doesn't worry her at all."
          },
          "sourceIds": [
            "film-f35"
          ],
          "questionIds": [
            "f35-026"
          ]
        }
      }
    },
    {
      "personId": "lynn",
      "filmId": "f42",
      "dims": {
        "education": {
          "status": "not_found"
        },
        "work": {
          "status": "confirmed",
          "text": {
            "zh": "流动图书馆关闭后，在 Bethnal Green 任区儿童图书管理员；兼任学校校董会主席。",
            "en": "Divisional children's librarian at Bethnal Green after the mobile library closed; also Chair of Governors at a Tower Hamlets school."
          },
          "sourceIds": [
            "film-f42"
          ]
        },
        "family": {
          "status": "confirmed",
          "text": {
            "zh": "19 岁嫁给 Russ；两个女儿已十几岁，Emma 刚考完 GCSE。",
            "en": "Married to Russ since 19; their daughters Sarah and Emma are teenagers, and Emma has just done her GCSEs."
          },
          "sourceIds": [
            "film-f42"
          ],
          "questionIds": [
            "f42-036"
          ]
        },
        "residence": {
          "status": "not_found"
        },
        "events": {
          "status": "confirmed",
          "text": {
            "zh": "上一部影片播出后不久，她的父亲去世。",
            "en": "Her father died just after the previous film was broadcast."
          },
          "sourceIds": [
            "film-f42"
          ]
        },
        "outlook": {
          "status": "confirmed",
          "text": {
            "zh": "她无法想象自己不工作：她喜欢那种兴奋和“把生活填满的冲劲”。",
            "en": "She can't see herself not working: she likes the excitement and \"the push of filling my life\"."
          },
          "sourceIds": [
            "film-f42"
          ],
          "questionIds": [
            "f42-035"
          ]
        }
      }
    },
    {
      "personId": "lynn",
      "filmId": "f49",
      "dims": {
        "education": {
          "status": "not_found"
        },
        "work": {
          "status": "confirmed",
          "text": {
            "zh": "仍在 Bethnal Green 图书馆做儿童图书管理员，但因削减开支，她说可能会失业。",
            "en": "Still a children's librarian at Bethnal Green Library, but because of cuts she said she might not have a job."
          },
          "sourceIds": [
            "film-f49"
          ],
          "questionIds": [
            "f49-070"
          ]
        },
        "family": {
          "status": "confirmed",
          "text": {
            "zh": "与 Russ 结婚 30 年，有两个女儿和一个外孙 Connor（Emma 之子）。",
            "en": "Married to Russ for 30 years, with two daughters and a grandson, Connor, Emma's son."
          },
          "sourceIds": [
            "film-f49"
          ],
          "questionIds": [
            "f49-065",
            "f49-068"
          ]
        },
        "residence": {
          "status": "not_found"
        },
        "events": {
          "status": "confirmed",
          "text": {
            "zh": "女儿 Emma 19 岁时生下儿子 Connor，她当上了外婆。",
            "en": "She became a grandmother when Emma, at 19, had a son, Connor."
          },
          "sourceIds": [
            "film-f49"
          ],
          "questionIds": [
            "f49-069"
          ]
        },
        "outlook": {
          "status": "confirmed",
          "text": {
            "zh": "她说这份辛苦的工作“非常有成就感”；被问一切是否值得，她说“非常值得”。",
            "en": "She called her demanding work \"so fulfilling\"; asked whether it had all been worth it, she said \"very much\"."
          },
          "sourceIds": [
            "film-f49"
          ],
          "questionIds": [
            "f49-071",
            "f49-073"
          ]
        }
      }
    },
    {
      "personId": "lynn",
