          ]
        },
        "family": {
          "status": "confirmed",
          "text": {
            "zh": "与 Russ 结婚 37 年，有三个外孙：Connor、Riley 和 Harry。",
            "en": "Married to Russ for 37 years, with three grandsons: Connor, Riley and Harry."
          },
          "sourceIds": [
            "film-f56"
          ],
          "questionIds": [
            "f56-075",
            "f56-076"
          ]
        },
        "residence": {
          "status": "not_found"
        },
        "events": {
          "status": "confirmed",
          "text": {
            "zh": "失去图书馆工作；外孙 Riley 出生仅两磅多；Sarah 婚后生下 Harry。",
            "en": "Lost her library job; grandson Riley was born weighing just over two pounds; daughter Sarah married and had a son, Harry."
          },
          "sourceIds": [
            "film-f56"
          ],
          "questionIds": [
            "f56-074"
          ]
        },
        "outlook": {
          "status": "confirmed",
          "text": {
            "zh": "她说家人一直是第一位的，并对自己的人生感到满意。",
            "en": "She said her family has always come first and that she is happy with the way her life has gone."
          },
          "sourceIds": [
